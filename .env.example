# Copiar a .env (ignorado por git) y completar. Nunca subir valores reales.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Base de datos (Neon en prod; docker-compose en local)
DATABASE_URL=jdbc:postgresql://localhost:5432/atlas
DB_USER=atlas
DB_PASSWORD=atlas
DB_POOL_SIZE=5
# Ejemplo Neon: jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
SPRINGDOC_ENABLED=true
# JWT (obligatorio en prod, minimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m
# Primer administrador (seed al arrancar; se omite si faltan)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Archivos: fake en local; r2 en produccion (el bucket necesita CORS para PUT desde el front)
MEDIA_PROVIDER=fake
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
